---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Hero from '@components/Hero.astro'
import FeaturedProjects from '@components/FeaturedProjects.astro'
import ContentMedia from '@components/ContentMedia.astro'
import ThemedImage from '@components/ThemedImage.astro'
import exposureShareCard from '@assets/images/projects/exposure-tracker.jpg'
import exposureMapLight from '@assets/images/projects/exposure-tracker/light/03-exposure-map.png'
import exposureMapDark from '@assets/images/projects/exposure-tracker/dark/03-exposure-map.png'
import { contactLabel, enquiryHref } from '../data/contact'

/* Each offering shows one real artefact from shipped work, linked to its case study. `focus` is the crop's
   object-position inside the card's 16:10 media slot. */
type Offering = {
  title: string
  text: string
  project: { name: string; href: string }
  focus: string
  alt: string
} & ({ src: string; width: number; height: number } | { light: ImageMetadata; dark: ImageMetadata })

const offerings: Offering[] = [
  {
    title: 'Development',
    text: 'Clean, fast, and accessible code from a product engineer trusted by companies of all sizes.',
    project: { name: 'SVPLY CHVN', href: '/portfolio/svply-chvn/' },
    src: '/projects/svply-chvn/project-image-3.png',
    width: 1200,
    height: 597,
    focus: '20% center',
    alt: 'The SVPLY CHVN album cover sliding aside to reveal a spinning vinyl record, rebuilt in CSS',
  },
  {
    title: 'UX',
    text: 'Simplify your website and remove friction so visitors can find what they need instantly.',
    project: { name: 'Everglades Experiences', href: '/portfolio/everglades-experiences/' },
    src: '/projects/everglades-experiences/project-image-2.png',
    width: 1200,
    height: 844,
    focus: 'top center',
    alt: 'Everglades Experiences shop page with an anchored sub-navigation above a row of wildlife prints',
  },
  {
    title: 'Design',
    text: 'Wireframes, mockups, and design systems crafted for your unique brand identity.',
    project: { name: 'IPSDI Exposure Tracker', href: '/portfolio/exposure-tracker/' },
    light: exposureMapLight,
    dark: exposureMapDark,
    focus: 'center 35%',
    alt: 'Exposure Tracker app screen with saved exposures pinned on a map',
  },
]

/* Structured data: the business, what it offers, and its featured work, matching what the page shows */
const site = Astro.site ?? new URL('https://www.benvent.com/')
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Ben Ventures',
  url: site.href,
  email: 'ben@benvent.com',
  description: 'Ben builds Shopify, React and mobile sites for small companies, from first setup to design systems.',
  address: { '@type': 'PostalAddress', addressRegion: 'NY', addressCountry: 'US' },
  founder: { '@type': 'Person', name: 'Ben' },
  makesOffer: offerings
    .map(({ title, text }) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: title, description: text },
    }))
    .concat([
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'New company setup',
          description: 'A domain, landing page, company email and email list for a new company.',
        },
      },
    ]),
  subjectOf: offerings.map(({ project }) => ({
    '@type': 'CreativeWork',
    name: project.name,
    url: new URL(project.href, site).href,
  })),
}
---

<DefaultLayout title="Ben Ventures">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Hero />

  <section class="section">
    <div class="container">
      <h2 class="section-head">My Offerings</h2>
      <ul class="offerings">
        {
          offerings.map((offering) => (
            <li>
              <a class="card" href={offering.project.href} style={`--focus: ${offering.focus}`}>
                <div class="card__media">
                  {'src' in offering ? (
                    <Image
                      src={offering.src}
                      alt={offering.alt}
                      width={offering.width}
                      height={offering.height}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <ThemedImage
                      light={offering.light}
                      dark={offering.dark}
                      alt={offering.alt}
                      widths={[400, 800]}
                      sizes="(min-width: 768px) 33vw, 100vw"
                    />
                  )}
                </div>
                <h3>{offering.title}</h3>
                <p class="muted">{offering.text}</p>
                <p class="meta">From {offering.project.name}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="principle">
    <div class="container">
      <span class="badge">Guiding Principle</span>
      <h2 class="band__statement" id="principle">Instinctive Design</h2>
      <p class="band__note">Every product is unique and every interaction is intuitive.</p>
    </div>
  </section>

  <ContentMedia
    img={exposureShareCard}
    imgAlt="IPSDI Exposure Tracker: “Firefighting isn’t getting any easier. Documenting your exposures is.” beside a phone showing saved exposures on a map"
  >
    <h2>Spotlight: IPSDI Exposure Tracker</h2>
    <p class="lead">
      A cross-platform application built for firefighters and first responders to securely document exposures,
      incidents, and long-term health risks.
    </p>
    <div class="btn-row">
      <a class="btn btn--primary" href="/portfolio/exposure-tracker/">View Case Study</a>
    </div>
  </ContentMedia>

  <FeaturedProjects title="Portfolio" />

  <ContentMedia spot="coming-soon">
    <h2>Starting a New Company?</h2>
    <p class="lead">
      Let me handle the technical setup while you focus on your business. I'll get you up and running with a domain,
      landing page, company email, and everything else you need to start collecting customers from day one.
    </p>
  </ContentMedia>

  <ContentMedia spot="advise">
    <h2>Need Advising?</h2>
    <p class="lead">
      New projects are overwhelming, and it helps to have someone who's been there. I'll ensure your design system,
      brand kit, and source code are built on a foundation for growth and consistency.
    </p>
  </ContentMedia>

  <section class="section section--closing">
    <div class="container">
      <h2 class="closing">Let's Get to Work.</h2>
      <div class="btn-row">
        <a class="btn btn--primary" href={enquiryHref()}>{contactLabel}</a>
      </div>
    </div>
  </section>
</DefaultLayout>

<style>
  .closing {
    margin-bottom: var(--space-6);
    font-size: var(--text-h1);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }
</style>
