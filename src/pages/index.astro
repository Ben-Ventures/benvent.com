---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Hero from '@components/Hero.astro'
import FeaturedProjects from '@components/FeaturedProjects.astro'
import ContentMedia from '@components/ContentMedia.astro'
import { contactLabel, enquiryHref } from '../data/contact'

/* What Ben offers. Not shown as cards (the two problem-led sections below say it in the client's words); kept here
   for the structured data, so search engines and AI assistants can still name each service. */
const services = [
  { title: 'Design', text: 'Wireframes, mockups and design systems built around your brand, not a template.' },
  { title: 'UX', text: 'Simpler sites with less friction, so visitors find what they need straight away.' },
  { title: 'Development', text: 'Clean, fast, accessible code from a product engineer.' },
]

/* How Ben works: the three Instinctive Design pillars, in the visitor's terms */
const pillars = [
  { tag: 'Uniqueness', line: 'Your site should look like you, not like a template.' },
  { tag: 'Intuitiveness', line: 'Nobody should need instructions to use it.' },
  { tag: 'Tailoring', line: 'It should meet every visitor where they are.' },
]

/* Structured data: the business, what it offers, and its featured work */
const site = Astro.site ?? new URL('https://www.benvent.com/')
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Ben Ventures',
  url: site.href,
  email: 'ben@benvent.com',
  address: { '@type': 'PostalAddress', addressRegion: 'NY', addressCountry: 'US' },
  founder: { '@type': 'Person', name: 'Ben' },
  makesOffer: services
    .map(({ title, text }) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: title, description: text },
    }))
    .concat([
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'New company setup',
          description: 'A domain, landing page, company email and email list for a new company.',
        },
      },
    ]),
  subjectOf: [
    { name: 'IPSDI Exposure Tracker', href: '/portfolio/exposure-tracker/' },
    { name: 'Everglades Experiences', href: '/portfolio/everglades-experiences/' },
    { name: 'To The Moon!', href: '/portfolio/to-the-moon/' },
    { name: 'The Nippies', href: '/portfolio/nippies/' },
  ].map(({ name, href }) => ({ '@type': 'CreativeWork', name, url: new URL(href, site).href })),
}
---

<DefaultLayout title="Ben Ventures">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Hero />

  <FeaturedProjects title="Portfolio" lead="exposure-tracker" />

  <section class="band" aria-labelledby="principle">
    <div class="container">
      <span class="badge">How I Work</span>
      <h2 class="band__statement" id="principle">Instinctive Design</h2>
      <ul class="pillars">
        {
          pillars.map(({ tag, line }) => (
            <li>
              <strong>{tag}</strong>
              <span>{line}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ContentMedia spot="coming-soon">
    <h2>Starting a New Company?</h2>
    <p class="lead">
      Let me handle the technical setup while you focus on your business. I'll get you a domain, a landing page designed
      around your brand, company email and everything else you need to start collecting customers from day one.
    </p>
  </ContentMedia>

  <ContentMedia spot="advise">
    <h2>Need Advising?</h2>
    <p class="lead">
      New projects are overwhelming, and it helps to have someone who's been there. From wireframes and UX to clean,
      fast, accessible code, I'll make sure your design system, brand kit and source code are built to grow.
    </p>
  </ContentMedia>

  <section class="section section--closing">
    <div class="container">
      <h2 class="closing">Let's Get to Work.</h2>
      <div class="btn-row">
        <a class="btn btn--primary" href={enquiryHref()}>{contactLabel}</a>
      </div>
    </div>
  </section>
</DefaultLayout>

<style>
  /* The three pillars in the band: stacked on phones, three across from 768px */
  .pillars {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-5) 0 0;
    padding: 0;
    max-width: none;
    list-style: none;
  }

  .pillars li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .pillars strong {
    color: var(--color-band-fg);
    font-weight: var(--weight-medium);
  }

  .pillars span {
    color: var(--color-band-muted);
  }

  @media (min-width: 768px) {
    .pillars {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }

  .closing {
    margin-bottom: var(--space-6);
    font-size: var(--text-h1);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }
</style>
