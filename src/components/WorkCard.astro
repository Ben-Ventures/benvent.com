---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import BrowserFrame from './BrowserFrame.astro'

/**
 * WorkCard Component
 *
 * @description A whole-card link to a project: media slot, title (with an optional badge), muted description, and a
 * small "Made with …" line for the platform. The screenshot sits in a brand BrowserFrame inside the card's 16:10
 * media slot.
 */
interface Props {
  href: string
  title: string
  description: string
  platform: string
  image?: ImageMetadata
  /**
   * CSS object-position for the screenshot's crop in the 16:10 slot (default: top, centred). Wide artwork whose
   * text sits near one edge, like a share card, can anchor that side so phones don't cut into it.
   */
  imagePosition?: string
  /**
   * A short label shown as the kit's magenta badge after the title, e.g. "Latest"
   */
  badge?: string
  /**
   * Heading level for the title; it is always styled at h3 size
   * @default 'h3'
   */
  headingLevel?: 'h2' | 'h3'
}

const { href, title, description, platform, image, imagePosition, badge, headingLevel: Heading = 'h3' } = Astro.props
---

<a class="card" href={href}>
  <div class="card__media">
    {
      image ? (
        <BrowserFrame variant="card">
          <Image
            src={image}
            alt=""
            widths={[400, 800]}
            sizes="(min-width: 1024px) 400px, 100vw"
            loading="lazy"
            style={imagePosition ? `object-position: ${imagePosition}` : undefined}
          />
        </BrowserFrame>
      ) : (
        <span class="card__placeholder">{title}</span>
      )
    }
  </div>
  <Heading class="work-card__title">
    {title}
    {badge && <span class="badge">{badge}</span>}
  </Heading>
  <p class="muted">{description}</p>
  <p class="meta">Made with {platform}</p>
</a>
