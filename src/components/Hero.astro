---
import { contactLabel, enquiryHref } from '../data/contact'

/**
 * Hero Component
 *
 * @description Home page hero: the page's one display headline (a question, with the answer in the yellow
 * highlighter, site.css override 8), one primary action and a quieter contact link. Words only: the work itself
 * follows in the Portfolio section, so the hero has no illustration.
 */
---

<section class="hero bg-grid">
  <div class="container">
    <h1 class="display">Is Your Website Stuck in 2016? <span class="highlight">Let's Rescue It.</span></h1>
    <div class="btn-row hero__actions">
      <a class="btn btn--magenta" href="/portfolio/">View Portfolio</a>
      <a class="hero__link" href={enquiryHref()}>{contactLabel}</a>
    </div>
  </div>
</section>

<style>
  .display {
    margin-bottom: var(--space-6);
    max-width: 18ch;
  }

  /* One filled button; contact is a quieter text link beside it, with a full tap target */
  .hero__actions {
    align-items: center;
    gap: var(--space-5);
  }

  .hero__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    font-weight: var(--weight-medium);
  }
</style>
