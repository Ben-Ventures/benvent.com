---
import ThemedImage from './ThemedImage.astro'
import detailsLight from '@assets/images/projects/exposure-tracker/app-store/iphone-details-light.png'
import detailsDark from '@assets/images/projects/exposure-tracker/app-store/iphone-details-dark.png'
import mapLight from '@assets/images/projects/exposure-tracker/app-store/iphone-map-light.png'
import mapDark from '@assets/images/projects/exposure-tracker/app-store/iphone-map-dark.png'
import { contactLabel, enquiryHref } from '../data/contact'

/**
 * Hero Component
 *
 * @description Home page hero on the kit's .hero__split: the page's one display headline, a plain factual line
 * about what Ben does, one primary action with a quieter contact link, and a proof point (a named client project
 * and its result, with two iPhone screenshots (exposure details and map) from the App Store brand kit, light and dark; never the iPad ones) that links to the case study. The proof sits beside the text from 768px and as a full-width showcase
 * under the actions on phones, so it is on the first screen at every size.
 *
 * Audience variant: visitors who arrive from a founder-focused link (`?for=founder`, or a utm_campaign /
 * utm_content containing "founder") get the "Starting a New Company?" lead and "Email Ben" as the primary action.
 * Both leads are in the HTML (crawlers and people see the same content); an inline script sets
 * `<html data-audience="founder">` before the hero paints, and CSS shows the matching one. Everything else on the
 * page stays the same. The variant's enquiries arrive with their own subject line (src/data/contact.ts), with the
 * default page as the control.
 */
const heroMessages = [
  "Is Your Website Stuck in 2010? Let's Rescue It.",
  'Website Looking Like MySpace? We Should Talk.',
]
const randomMessage = heroMessages[Math.floor(Math.random() * heroMessages.length)]
---

<script is:inline>
  ;(function () {
    var q = new URLSearchParams(location.search)
    var hit = function (v) {
      return !!v && /founder/i.test(v)
    }
    if (q.get('for') === 'founder' || hit(q.get('utm_campaign')) || hit(q.get('utm_content'))) {
      document.documentElement.dataset.audience = 'founder'
    }
  })()
</script>

<section class="hero bg-grid">
  <div class="container hero__split">
    <div>
      <div class="hero__lead hero__lead--default">
        <h1 class="display">{randomMessage}</h1>
        <p class="lead hero__summary">
          Ben builds Shopify, React and mobile sites for small companies, from first setup to design systems.
        </p>
        <div class="btn-row hero__actions">
          <a class="btn btn--magenta" href="/portfolio/">View Portfolio</a>
          <a class="hero__link" href={enquiryHref()}>{contactLabel}</a>
        </div>
      </div>
      <div class="hero__lead hero__lead--founder">
        <p class="display" role="heading" aria-level="1">Starting a New Company?</p>
        <p class="lead hero__summary">
          Ben sets you up with a domain, a landing page, company email and an email list, so you can start collecting
          customers from day one.
        </p>
        <div class="btn-row hero__actions">
          <a class="btn btn--magenta" href={enquiryHref('founder')}>{contactLabel}</a>
          <a class="hero__link" href="/portfolio/">View Portfolio</a>
        </div>
      </div>
    </div>
    <a class="hero__art hero-proof" href="/portfolio/exposure-tracker/">
      <span class="hero-proof__media">
        {
          [
            [detailsLight, detailsDark],
            [mapLight, mapDark],
          ].map(([light, dark]) => (
            <span class="hero-proof__shot">
              <ThemedImage
                light={light}
                dark={dark}
                alt=""
                widths={[200, 400, 700]}
                sizes="(min-width: 1280px) 15rem, (min-width: 768px) 20vw, 50vw"
                loading="eager"
                class="media-bare"
              />
            </span>
          ))
        }
      </span>
      <span class="hero-proof__text">
        <span class="hero-proof__name">IPSDI Exposure Tracker</span>
        <span class="hero-proof__result">One codebase for iOS, Android and web, built for firefighters.</span>
      </span>
    </a>
  </div>
</section>

<style>
  .display {
    margin-bottom: var(--space-4);
  }

  .hero__summary {
    margin-bottom: var(--space-6);
    max-width: 34rem;
  }

  /* Only one lead shows. The founder lead is a <p role="heading"> so the page keeps a single real h1 */
  .hero__lead--founder,
  :global(html[data-audience='founder']) .hero__lead--default {
    display: none;
  }

  :global(html[data-audience='founder']) .hero__lead--founder {
    display: block;
  }

  /* One filled button; contact is a quieter text link beside it, with a full tap target */
  .hero__actions {
    align-items: center;
    gap: var(--space-5);
  }

  .hero__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    font-weight: var(--weight-medium);
  }

  /* ---- Proof point ---- */
  .hero-proof {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  /* The App Store kit's screenshot (its own caption and device), cropped from the top to 4:3 and outlined */
  .hero-proof__media {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: var(--border-strong) solid var(--color-outline);
    border-radius: var(--radius);
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .hero-proof__shot {
    min-height: 0;
    overflow: hidden;
  }

  .hero-proof__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .hero-proof__text {
    display: block;
    margin-top: var(--space-3);
  }

  .hero-proof__name {
    display: block;
    font-weight: var(--weight-medium);
    text-decoration: underline 2px var(--color-underline);
    text-underline-offset: 0.2em;
  }

  .hero-proof:hover .hero-proof__name {
    color: var(--color-accent);
  }

  .hero-proof__result {
    display: block;
    color: var(--color-fg-muted);
    font-size: var(--text-sm);
  }

  /* Phones: less space above the headline, and the proof as a full-width showcase under the actions: both phones
     side by side in a 2:1 crop, the caption below, so it reads as the example rather than a footnote and still lands
     on the first screen */
  @media (max-width: 767.98px) {
    .hero {
      padding-top: var(--space-6);
    }

    .hero__summary {
      margin-bottom: var(--space-5);
    }

    .hero-proof {
      justify-self: stretch;
      order: 1;
      width: 100%;
    }

    .hero-proof__media {
      aspect-ratio: 2 / 1;
    }

    .hero-proof__text {
      display: flex;
      column-gap: var(--space-2);
      flex-wrap: wrap;
      align-items: baseline;
    }
  }
</style>
