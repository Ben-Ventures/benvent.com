---
import Logo from './Logo.astro'

/**
 * Footer Component
 *
 * @description Site footer: mark at 24px, © line, the sitemap link. Contact lives in the hero and the closing
 * section, so the footer doesn't repeat it; the theme toggle is in the header.
 */
const currentYear = new Date().getFullYear()
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <a class="site-footer__logo" href="/" aria-label="Ben Ventures, home">
      <Logo variant="mark" />
    </a>
    <p>&copy; {currentYear} Ben Ventures LLC, a New York company.</p>
    <ul>
      <li><a href="/sitemap/">Sitemap</a></li>
    </ul>
  </div>
</footer>
