---
import { getCollection } from 'astro:content'
import type { ImageMetadata } from 'astro'
import WorkCard from './WorkCard.astro'

/**
 * FeaturedProjects Component
 *
 * @description A component that displays featured projects from Astro Content Collections
 */
interface Props {
  /**
   * Eyebrow label above the section title
   */
  eyebrow?: string
  /**
   * The number of projects to display
   * @default 3
   */
  limit?: number
  /**
   * The title for the section
   * @default "Selected work"
   */
  title?: string
  /**
   * A project id (its file name without .mdx) to show first, whether or not it's flagged as featured
   */
  lead?: string
}

const { eyebrow, limit = 3, title = 'Selected work', lead } = Astro.props
const slugOf = (id: string) => id.replace(/\.mdx?$/, '')

// Get projects from content collection
const projects = await getCollection('projects', ({ data }) => !data.isHidden)

// Dynamically import all images from the projects folder
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/projects/*.{png,jpg,jpeg,webp}', {
  eager: true,
})

// Filter featured projects and sort them
const isLead = (id: string) => !!lead && slugOf(id) === lead
const featuredProjects = projects
  .filter((project) => project.data.isFeatured || isLead(project.id))
  .sort((a, b) => Number(isLead(b.id)) - Number(isLead(a.id)) || a.data.sortOrder - b.data.sortOrder)
  .slice(0, limit)
  .map((project) => ({
    ...project,
    imageComponent: images[`/src/assets/images/projects/${project.data.featuredImage}`]?.default,
  }))
---

<section class="section">
  <div class="container">
    <div class="section-head">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h2>{title}</h2>
    </div>
    <ul class="grid">
      {
        featuredProjects.map((project) => (
          <li>
            <WorkCard
              href={'/portfolio/' + project.id.replace(/\.mdx?$/, '')}
              title={project.data.title}
              description={project.data.description}
              platform={project.data.platform}
              image={project.imageComponent}
              badge={project.data.badge}
            />
          </li>
        ))
      }
    </ul>
    <div class="section-cta">
      <a class="btn btn--secondary" href="/portfolio/">See More</a>
    </div>
  </div>
</section>

<style>
  /* Tablet: the kit grid is 8 columns and each card spans 4, so three cards would leave a hole. The lead project
     spans the full width instead, with the next two side by side under it. Phones stay one column, desktop three. */
  @media (min-width: 768px) and (max-width: 1023.98px) {
    .grid > li:first-child {
      grid-column: 1 / -1;
    }
  }
</style>
