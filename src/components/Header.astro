---
import Logo from './Logo.astro'

/**
 * Header Component
 *
 * @description Sticky site header: logo home link and main navigation. The links stay visible at every width;
 * below 768px the Home item is dropped because the logo is the Home link (site.css override 9, in place of the kit's
 * "Menu" panel, docs/brand/WEB.md §7).
 */
const links = [
  { href: '/', label: 'Home' },
  { href: '/portfolio/', label: 'Portfolio' },
  { href: '/about/', label: 'About' },
]

const path = Astro.url.pathname
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href.replace(/\/$/, '')))
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__logo" href="/" aria-label="Ben Ventures, home">
      <Logo variant="lockup" class="logo-full" />
      <Logo variant="mark" class="logo-compact" />
    </a>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {
          links.map(({ href, label }) => (
            <li class={href === '/' ? 'site-nav__item--home' : undefined}>
              <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
