---
import { Icon } from 'astro-icon/components'
import Logo from './Logo.astro'

/**
 * Header Component
 *
 * @description Sticky site header with a permanent 2px bottom edge: logo home link and main navigation. Below
 * 768px the navigation collapses behind a "Menu" text button into a full-screen panel (docs/brand/WEB.md §7). Light
 * and dark mode: a sun / moon icon button after the links from 768px, and a Light / Dark pair at the bottom of the
 * phone menu panel.
 */
const links = [
  { href: '/', label: 'Home' },
  { href: '/portfolio/', label: 'Portfolio' },
  { href: '/about/', label: 'About' },
]

const path = Astro.url.pathname
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href.replace(/\/$/, '')))
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__logo" href="/" aria-label="Ben Ventures, home">
      <Logo variant="lockup" class="logo-full" />
      <Logo variant="mark" class="logo-compact" />
    </a>
    <div class="site-header__actions">
      <nav id="site-nav" class="site-nav" aria-label="Main">
        <ul>
          {
            links.map(({ href, label }) => (
              <li>
                <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="theme-switch" role="group" aria-label="Theme">
          <button type="button" data-theme-choice="light" aria-pressed="false">
            <Icon name="lucide:sun" aria-hidden="true" />Light
          </button>
          <button type="button" data-theme-choice="dark" aria-pressed="false">
            <Icon name="lucide:moon" aria-hidden="true" />Dark
          </button>
        </div>
      </nav>
      <button class="theme-toggle" type="button" aria-label="Switch to dark mode">
        <Icon name="lucide:moon" class="theme-image--light" aria-hidden="true" />
        <Icon name="lucide:sun" class="theme-image--dark" aria-hidden="true" />
      </button>
      <button class="site-nav__toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.site-nav__toggle')
  const nav = document.getElementById('site-nav')

  if (toggle && nav) {
    const setOpen = (open: boolean, moveFocus = false) => {
      toggle.setAttribute('aria-expanded', String(open))
      toggle.textContent = open ? 'Close' : 'Menu'
      nav.toggleAttribute('data-open', open)
      document.documentElement.classList.toggle('menu-open', open)
      if (open && moveFocus) nav.querySelector('a')?.focus()
    }

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true', true))
    nav.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setOpen(false)
    })
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false)
        toggle.focus()
      }
    })
    matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false)
    })
  }

  /* Theme: follows the OS until the visitor picks one, then the choice is stored per browser under "bv-theme"
     (DefaultLayout applies it before paint). Two controls: the sun / moon icon button in the bar from 768px, which
     flips whatever is showing, and the Light / Dark pair at the bottom of the phone menu panel. The icon button's
     icons swap by CSS (.theme-image--light/dark in site.css). */
  const root = document.documentElement
  const themeButton = document.querySelector<HTMLButtonElement>('.theme-toggle')
  const themeChoices = document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]')
  const prefersDark = matchMedia('(prefers-color-scheme: dark)')
  const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : prefersDark.matches)

  const show = () => {
    const dark = isDark()
    themeButton?.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode')
    themeChoices.forEach((choice) =>
      choice.setAttribute('aria-pressed', String((choice.dataset.themeChoice === 'dark') === dark)),
    )
  }

  const setTheme = (next: 'light' | 'dark') => {
    root.dataset.theme = next
    document
      .querySelectorAll('meta[name="theme-color"]')
      .forEach((meta) => meta.setAttribute('content', next === 'dark' ? '#231F20' : '#F4F1EA'))
    try {
      localStorage.setItem('bv-theme', next)
    } catch {
      /* storage blocked: the choice lasts for this page only */
    }
    show()
  }

  themeButton?.addEventListener('click', () => setTheme(isDark() ? 'light' : 'dark'))
  themeChoices.forEach((choice) =>
    choice.addEventListener('click', () => setTheme(choice.dataset.themeChoice === 'dark' ? 'dark' : 'light')),
  )
  prefersDark.addEventListener('change', show)
  show()
</script>
